{"tldrawFileFormatVersion":1,"schema":{"schemaVersion":2,"sequences":{"com.tldraw.store":5,"com.tldraw.asset":1,"com.tldraw.camera":1,"com.tldraw.document":2,"com.tldraw.instance":26,"com.tldraw.instance_page_state":5,"com.tldraw.page":1,"com.tldraw.instance_presence":6,"com.tldraw.pointer":1,"com.tldraw.shape":4,"com.tldraw.user":1,"com.tldraw.asset.image":6,"com.tldraw.asset.video":5,"com.tldraw.asset.bookmark":2,"com.tldraw.shape.arrow":8,"com.tldraw.shape.bookmark":2,"com.tldraw.shape.draw":5,"com.tldraw.shape.embed":4,"com.tldraw.shape.frame":1,"com.tldraw.shape.geo":12,"com.tldraw.shape.group":0,"com.tldraw.shape.highlight":4,"com.tldraw.shape.image":5,"com.tldraw.shape.line":5,"com.tldraw.shape.note":13,"com.tldraw.shape.text":4,"com.tldraw.shape.video":4,"com.tldraw.binding.arrow":1,"com.tldraw.comment-thread":3,"com.tldraw.comment":1,"com.tldraw.comment-reaction":1}},"records":[{"meta":{},"id":"page:page","name":"Page 1","index":"a1","typeName":"page"},{"meta":{},"id":"binding:-mjyntaksS4G1yg9WLe7-","type":"arrow","fromId":"shape:bPYI2f-mwU-wVtKaexGL3","toId":"shape:NUHkaMSiB4z3o7GI1fpSc","props":{"isPrecise":true,"isExact":false,"normalizedAnchor":{"x":0.09985068016896605,"y":0.9068565548924277},"snap":"none","terminal":"start"},"typeName":"binding"},{"x":9192.826449028047,"y":-762.6856798540007,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:2hdlpgwcoHo9yoUA_RBYN","type":"text","props":{"color":"black","size":"m","w":1795.73388671875,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Private WAN technologies"},{"type":"text","text":" provide dedicated, secure, and high-performance connectivity for organizations with multiple locations.  These technologies can be categorized by OSI layer and deployment type, offering flexibility based on performance, cost, and scalability needs. "}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Layer 1 Technologies"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Leased Lines"},{"type":"text","text":": Dedicated point-to-point connections (e.g., T1/E1, T3/E3) over copper or fiber, offering guaranteed bandwidth and low latency. Historically common but increasingly phased out due to cost. "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Dark Fibre"},{"type":"text","text":": Fully dedicated fiber-optic cable leased from a provider. Offers maximum control, speed (up to 100 Gbps+), and low latency, but requires significant investment in equipment and expertise. "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Optical Wavelength Services"},{"type":"text","text":": Leased specific wavelengths over fiber (e.g., via DWDM), providing high-speed, dedicated channels. Can operate at Layer 1 (raw fiber) or Layer 2 (Ethernet handoff). "}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Layer 2 Technologies"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Ethernet Private Line (EPL)"},{"type":"text","text":": Point-to-point Ethernet connectivity with dedicated bandwidth (10 Mbps to 100 Gbps). Ideal for high-bandwidth, low-latency needs like data center interconnects. "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Ethernet Virtual Private Line (EVPL)"},{"type":"text","text":": Point-to-multipoint Ethernet service using MPLS, allowing multiple sites to connect to a central hub. Cost-effective and scalable, with traffic prioritization. "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Virtual Private LAN Service (VPLS)"},{"type":"text","text":": Emulates a single LAN across multiple sites over an MPLS network. Enables MAC address exchange and supports meshed topologies, ideal for distributed branch connectivity. "}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Layer 3 Technologies"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Multiprotocol Label Switching (MPLS)"},{"type":"text","text":": Uses label-based routing for efficient, QoS-enabled traffic delivery across a provider’s network. Supports diverse access technologies (DSL, fiber, etc.) and offers SLA-backed performance. Commonly used for enterprise-wide private WANs. "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"IPsec VPN"},{"type":"text","text":": Secure, encrypted tunnels over the public internet. Cost-effective and easy to deploy, but performance depends on internet quality. Often used in hybrid or SD-WAN environments. "}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Software-Defined WAN (SD-WAN)"},{"type":"text","text":": A modern, software-driven approach that aggregates multiple connections (MPLS, broadband, LTE/5G) and intelligently routes traffic based on application, user, or QoS policies. Enhances flexibility, reduces costs, and improves performance. "}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Hybrid & Emerging Options"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Hybrid Cloud Networking"},{"type":"text","text":": Combines private WAN with public cloud services using technologies like "},{"type":"text","marks":[{"type":"bold"}],"text":"SASE (Secure Access Service Edge)"},{"type":"text","text":", "},{"type":"text","marks":[{"type":"bold"}],"text":"SD-WAN"},{"type":"text","text":", and "},{"type":"text","marks":[{"type":"bold"}],"text":"cloud direct connect"},{"type":"text","text":" for secure, optimized cloud access."}]}]}]}]}},"parentId":"page:page","index":"a1TcVT7V","typeName":"shape"},{"x":11423.921720646513,"y":-596.922130967893,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:gOzcepI2G8TJnQO6JCKxS","type":"image","props":{"w":1898,"h":452,"assetId":"asset:168706943","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"a25zn6il","typeName":"shape"},{"x":9196.461579949992,"y":338.60329416663194,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:rJCoHncQWGG-qhsU7K8-U","type":"text","props":{"color":"black","size":"m","w":1570.8146861197542,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Binary to decimal convertion:"}]}]}},"parentId":"page:page","index":"a3WzZoYG","typeName":"shape"},{"x":9219.885104864496,"y":410.29826817093044,"rotatio