paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Used to send data to many devices at once (streaming, video conferences)."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","text":"🔹 "},{"type":"text","marks":[{"type":"bold"}],"text":"Class E"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Range:"},{"type":"text","text":" "},{"type":"text","marks":[{"type":"code"}],"text":"240.0.0.0 – 255.255.255.255"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Purpose:"},{"type":"text","text":" Experimental / research."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Not used in normal networks."}]}]}]}]}},"parentId":"page:page","index":"b7nxZZM7V","typeName":"shape"},{"x":4091.2509539617677,"y":12622.666538739764,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:i4wzcTtjmE1zLBFmlqKUB","type":"image","props":{"w":1608.5742813134834,"h":844.124656325148,"assetId":"asset:-1122645045","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"b7u8YMngV","typeName":"shape"},{"meta":{},"id":"binding:PFrZD3W7XSM7Zb7QG0WSQ","type":"arrow","fromId":"shape:GrEO-BuCI4zxY7WCquj25","toId":"shape:i4wzcTtjmE1zLBFmlqKUB","props":{"isPrecise":true,"isExact":false,"normalizedAnchor":{"x":0.2616040859817154,"y":0.706495756146703},"snap":"center","terminal":"start"},"typeName":"binding"},{"x":6672.054660598822,"y":12931.959206479818,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:GrEO-BuCI4zxY7WCquj25","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color