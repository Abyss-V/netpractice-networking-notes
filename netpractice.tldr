jUA_5578ow6VtJGL","type":"text","props":{"color":"black","size":"l","w":366.06205471363,"font":"draw","textAlign":"start","autoSize":false,"scale":0.8277048115397299,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Network Address"}]}]}},"parentId":"page:page","index":"b7hFOqkzG","typeName":"shape"},{"x":6197.704052457288,"y":7865.411712031172,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:229VWoObzQb6VGWxZDoB0","type":"text","props":{"color":"black","size":"l","w":276.4187734721663,"font":"draw","textAlign":"start","autoSize":false,"scale":0.8277048115397299,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Host Address"}]}]}},"parentId":"page:page","index":"b7iWHH1uV","typeName":"shape"},{"x":5409.8954634465235,"y":4776.23952800156,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:5PlWvOB2XHFd453SFlao3","type":"text","props":{"color":"black","size":"xl","w":783.8167946846352,"font":"draw","textAlign":"middle","autoSize":true,"scale":2.2537731040140425,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Network layer:"}]}]}},"parentId":"page:page","index":"b8hyAXP9V","typeName":"shape"},{"x":4031.879834911975,"y":5025.996264250337,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:zlyPQd0F_4wVBoTPogcaf","type":"text","props":{"color":"black","size":"xl","w":3826.2281339128567,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"Network Layer"},{"type":"text","text":" is the "},{"type":"text","marks":[{"type":"bold"}],"text":"third layer of the OSI model"},{"type":"text","text":", standardized by the International Organization for Standardization, and its main purpose is to "},{"type":"text","marks":[{"type":"bold"}],"text":"determine how data is sent from one device to another across multiple networks"},{"type":"text","text":". This layer is responsible for "},{"type":"text","marks":[{"type":"bold"}],"text":"logical addressing, routing, and packet forwarding"},{"type":"text","text":", allowing data to travel from the source device to the destination device even if they are on different networks or far apart geographically. Unlike the Transport Layer, which ensures reliable delivery, the Network Layer focuses on "},{"type":"text","marks":[{"type":"bold"}],"text":"finding the best path for data to reach its destination"},{"type":"text","text":"."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"A key function of the Network Layer is "},{"type":"text","marks":[{"type":"bold"}],"text":"logical addressing"},{"type":"text","text":", which uses addresses like IP addresses to uniquely identify devices on a network."}]}]}},"parentId":"page:page","index":"b8gRxlIbV","typeName":"shape"},{"id":"asset:-216324696","type":"image","typeName":"asset","props":{"name":"tldrawFile","src":"data:image/png;base64,","w":816,"h":547,"fileSize":195575,"mimeType":"image/png","isAnimated":false},"meta":{"fileId":"vqNuFD_oI1j_Efbg0Hhi9"}},{"x":-986.6055332359697,"y":19565.997058106153,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:C10uwVNDhUe40AD7N0Phv","type":"text","props":{"color":"black","size":"xl","w":748.841256294324,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.32468023257681,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"OSI MODEL"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"(Open Systems interconnection)"}]}]}},"parentId":"page:page","index":"b3dlPUH1G","typeName":"shape"},{"x":-997.7494181737002,"y":20381.9482081582,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:7thyYZEb8ZNfYjKfhJ48f","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":448.5870361328125,"y":1.17431640625},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b3fz6RU5O","typeName":"shape"},{"x":-514.1072062596378,"y":20309.975937192623,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:pzkuXO3GtLYV44ToR4U_h","type":"text","props":{"color":"black","size":"xl","w":1455.602333288908,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Layer that perform the action such as download the file request a page ,.. using different protocols such as https , ftp , smtp for sending email,...."}]}]}},"parentId":"page:page","index":"b3ggikPZV","typeName":"shape"},{"x":-989.9801465578057,"y":20625.03072768945,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:ePCdXV4WR-c8fOK4GtDdT","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":449.7613525390625,"y":1.17431640625},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b3ih5sJ3V","typeName":"shape"},{"x":-514.3835889406183,"y":20538.966903989498,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:76LlJTGz21uoraYPaCUO4","type":"text","props":{"color":"black","size":"xl","w":1278.1794721493084,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Takes data from the application layer choose the right file format and turn it to machine language 0's and 1's, compress it and encrypt it "}]}]}},"parentId":"page:page","index":"b3jyRaPMV","typeName":"shape"},{"x":-987.6262804423545,"y":20934.755703275387,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:f7rGCNZ6oyxBEk9H6d3B2","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":450.935791015625,"y":-1.17431640625},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b3lT5Uj8l","typeName":"shape"},{"x":-979.2191660163976,"y":21254.168789212887,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:hYA4ssL69B4b8jzKCpYBY","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":457.981689453125,"y":2.348388671875},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b3oA4zb4l","typeName":"shape"},{"x":-963.9402921674227,"y":21888.29732925195,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:YUZcIlwMnH6WDCrX9SBze","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":358.1651611328125,"y":3.52294921875},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b3rKKDOFV","typeName":"shape"},{"x":-529.4450529096104,"y":21762.306503598873,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:usrLCT88FnCll11L1HbQP","type":"text","props":{"color":"black","size":"xl","w":1512.9083251953125,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Responsible for logical addressing , it takes data segments from transport layer and add to it source and destination ip addresses and this is called packet also the network layer does the routing means it chooses the best path for packet to reach the destination in shortest time using protocols such as (RIP: Routing Information Protocol or OSPF: Open Shortest Path First)"}]}]}},"parentId":"page:page","index":"b3s4XnBjV","typeName":"shape"},{"x":-944.7782739748659,"y":22446.095547025387,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:kRX5qo99eagEopR61bCvW","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":319.412841796875,"y":1.17431640625},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b3u0aEAZV","typeName":"shape"},{"x":-935.1873511382041,"y":23019.3066065957,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:_CUyFKCwNQsDnGWmyRp9L","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":430.97265625,"y":-2.3487548828125},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b3xSWMFDV","typeName":"shape"},{"x":-501.86594000539174,"y":22959.511434655757,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:ihRXGyqGk2R-KYGmyMda4","type":"text","props":{"color":"black","size":"xl","w":1257.684780956807,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Recieve data as stream of bits and convert to signals so that transmission media (ethernet cables, radio wave,...) will send it to the destination"}]}]}},"parentId":"page:page","index":"b3yuNmTFV","typeName":"shape"},{"x":-1631.403363127476,"y":23295.011583034116,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:tSt4B8QCr-7wyib-CmkG0","type":"image","props":{"w":2448.253525270972,"h":1281.252678225142,"assetId":"asset:-1792423357","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"b3zcvZ1qV","typeName":"shape"},{"x":-2081.024521387035,"y":20166.920265629175,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:zrxcRTld9ImuKYmdXx3Rq","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":26.27895868324549,"y":2956.3907909212176},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b40JjZBeV","typeName":"shape"},{"x":-2613.1747578987724,"y":21648.267155575424,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Ek8fo5e4iToa0ENtnlXIj","type":"text","props":{"color":"black","size":"xl","w":617.2088785192695,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Encapsulation"}]}]}},"parentId":"page:page","index":"b42v8kdvV","typeName":"shape"},{"x":-2570.4714286969497,"y":23133.165730081255,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:YifRegHQWICEqSwIQVSZ-","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":6.569782353908522,"y":-2969.5305263614264},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b43UpA8aG","typeName":"shape"},{"x":-3046.7788780067913,"y":21654.836937929333,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:-v9Pq6B_oLxYdXuFFArOt","type":"text","props":{"color":"black","size":"xl","w":393.8019213339431,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Dencapsulation"}]}]}},"parentId":"page:page","index":"b44M3DJTV","typeName":"shape"},{"x":-496.2647847156122,"y":18690.38456564237,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:xETzDekDyDDMf8AoVryJK","type":"text","props":{"color":"black","size":"xl","w":377.4320276545641,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.1069120694472034,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Access point"}]}]}},"parentId":"page:page","index":"b6NsQpP1V","typeName":"shape"},{"x":-1708.794044993148,"y":19975.342862509777,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:T9H7j1N9sfM042FpB6Qmb","type":"text","props":{"color":"black","size":"xl","w":3230.3346907033483,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"the purpose of this model to allow different systems to communicate smoothly regardless of their internal architecture, hardware or software."}]}]}},"parentId":"page:page","index":"b6U8fUTml","typeName":"shape"},{"x":-243.49249588159046,"y":19067.548906577893,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:_pvtf6ioqtfDg9rYrQMEe","type":"text","props":{"color":"black","size":"xl","w":123.63301849365234,"font":"draw","textAlign":"middle","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Bridge"}]}]}},"parentId":"page:page","index":"b6fPLYuIV","typeName":"shape"},{"x":-1926.236162155914,"y":25235.091241777583,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:bxjlEko4Y2N_QbwHrZ-PQ","type":"text","props":{"color":"black","size":"xl","w":3150.75868941477,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"Application Layer"},{"type":"text","text":" is the "},{"type":"text","marks":[{"type":"bold"}],"text":"seventh and highest layer of the OSI model"},{"type":"text","text":", which was standardized by the International Organization for Standardization, and it is the layer that interacts "},{"type":"text","marks":[{"type":"bold"}],"text":"directly with end-user software"},{"type":"text","text":". Its main role is to provide "},{"type":"text","marks":[{"type":"bold"}],"text":"network services to applications"},{"type":"text","text":", not to the user themselves, meaning it acts as the interface between application programs (such as web browsers, email clients, or file transfer tools) and the underlying network. This layer is responsible for enabling applications to "},{"type":"text","marks":[{"type":"bold"}],"text":"access network resources"},{"type":"text","text":", determine whether sufficient resources are available, and initiate communication with remote systems in a way that is meaningful to the application’s purpose."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"At the Application Layer, data is handled in a "},{"type":"text","marks":[{"type":"bold"}],"text":"human-usable form"},{"type":"text","text":", rather than as raw bits or frames. It defines "},{"type":"text","marks":[{"type":"bold"}],"text":"protocols and rules"},{"type":"text","text":" that allow software applications to perform specific network-related tasks such as web communication, email exchange, file transfers, remote login, and name resolution. Common protocols operating at this layer include HTTP for web communication, FTP for file transfers, SMTP for sending emails, POP3 or IMAP for receiving emails, and DNS for translating domain names into IP addresses. These protocols do not deal with how data is physically transmitted; instead, they define "},{"type":"text","marks":[{"type":"bold"}],"text":"what data is requested, how it is requested, and how responses are interpreted"},{"type":"text","text":" by applications."}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"header"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The application layer encapsulates the data and add to it a header that contain the protocol and information used, still named "},{"type":"text","marks":[{"type":"bold"}],"text":"data"},{"type":"text","text":"."}]}]}},"parentId":"page:page","index":"b8Mci4VxV","typeName":"shape"},{"x":-1710.4016551411933,"y":24968.15692571209,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:abatXGLtnJS5lI36D2iKx","type":"text","props":{"color":"black","size":"xl","w":916.5878191360855,"font":"draw","textAlign":"middle","autoSize":false,"scale":3.247826334963859,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Application Layer"}]}]}},"parentId":"page:page","index":"b8NnKbwVV","typeName":"shape"},{"x":-1525.4702819354052,"y":26190.994006927598,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:A2W5FXVCYzrGUCpD5YEIn","type":"text","props":{"color":"black","size":"xl","w":916.5878191360855,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.8824362134522583,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Presentation Layer"}]}]}},"parentId":"page:page","index":"b8OXJ4QPV","typeName":"shape"},{"x":-1919.1791066791093,"y":26466.02333190209,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:LfGsoXSuRXc-Hds5N_bN0","type":"text","props":{"color":"black","size":"xl","w":3225.722009593392,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"Presentation Layer"},{"type":"text","text":" is the "},{"type":"text","marks":[{"type":"bold"}],"text":"sixth layer of the OSI model"},{"type":"text","text":", defined by the International Organization for Standardization, and its primary responsibility is to ensure that data exchanged between systems is "},{"type":"text","marks":[{"type":"bold"}],"text":"understandable and usable"},{"type":"text","text":" by the receiving application. It acts as a "},{"type":"text","marks":[{"type":"bold"}],"text":"translator"},{"type":"text","text":" between the Application Layer and the lower layers by converting data formats, character encodings, and data representations so that systems with different internal formats can communicate correctly. Without the Presentation Layer, two applications might successfully exchange data but still be unable to interpret it due to incompatible formats."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"this layer is responsible for "},{"type":"text","marks":[{"type":"bold"}],"text":"data compression"},{"type":"text","text":", which reduces the size of the data to optimize bandwidth usage and improve transmission efficiency."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Another critical role of the Presentation Layer is "},{"type":"text","marks":[{"type":"bold"}],"text":"encryption and decryption"},{"type":"text","text":". To protect data confidentiality, this layer can encrypt data before it is sent over the network and decrypt it when it is received. This ensures that even if data is intercepted during transmission, it cannot be understood without the proper decryption keys. In real-world networking, technologies such as TLS/SSL conceptually operate at this layer, providing secure data representation for applications while relying on lower layers for transport and delivery."}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"header"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Contain the information specifying the "},{"type":"text","marks":[{"type":"bold"}],"text":"data format"},{"type":"text","text":" used like JPEG, MP4, PDF ... also metadata necessary to correctly decrypt the incoming data, and then information about the compression algorithm used allowing the receiver to decompress the data correctly. Still named by data."}]}]}},"parentId":"page:page","index":"b8PnkJDjV","typeName":"shape"},{"x":-850.1870869249296,"y":27472.967878119573,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:r0pA1JfifEW9399xs3qJQ","type":"text","props":{"color":"black","size":"xl","w":192.31192016601562,"font":"draw","textAlign":"middle","autoSize":true,"scale":3.300152357457445,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Session Layer :"}]}]}},"parentId":"page:page","index":"b8QBirhZV","typeName":"shape"},{"x":-1929.4676907062385,"y":27699.182873942496,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:1HkzldLilaY8jsES2a58p","type":"text","props":{"color":"black","size":"xl","w":3378.59956912847,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"Session Layer"},{"type":"text","text":" is the fifth layer of the OSI (Open Systems Interconnection) reference model, sitting between the Transport Layer (Layer 4) below it and the Presentation Layer (Layer 6) above it. Its primary responsibility is to establish, manage, maintain, and terminate communication sessions between two networked applications or devices. A session, in this context, refers to a logical connection or dialogue between two parties that allows them to exchange data in an organized and synchronized manner over a period of time."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The Session Layer is responsible for session establishment, which involves setting up the rules and parameters for communication before any data exchange begins. Once a session is active, this layer continuously manages it by controlling the dialogue between the communicating systems, determining who can transmit data at a given moment and in what direction, whether that be simplex (one direction only), half-duplex (one direction at a time), or full-duplex (both directions simultaneously). This dialogue control ensures that data flows in an orderly and conflict-free manner between both ends of the communication."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"One of the most critical functions of the Session Layer is synchronization, achieved through the use of checkpoints or synchronization points inserted into the data stream. These checkpoints allow communication to be resumed from a known good state in the event of a failure or interruption, rather than restarting the entire transmission from the beginning. For example, if a large file transfer is interrupted midway, the session layer can use these synchronization points to resume the transfer from the last confirmed checkpoint, improving both reliability and efficiency."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The Session Layer also handles session termination, ensuring that a session is closed gracefully and that all data has been properly exchanged before the connection is torn down. In practice, many of the Session Layer's functions are implemented within application-layer protocols such as RPC (Remote Procedure Call), NetBIOS, PPTP, and SIP (Session Initiation Protocol), as modern networking stacks like TCP/IP do not have a distinct session layer but incorporate its functions across other layers."}]}]}},"parentId":"page:page","index":"b8RHJFOpV","typeName":"shape"},{"x":-1125.459171800162,"y":29029.723417030647,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:ye6LGoUeaCDdM3tijYXjV","type":"text","props":{"color":"black","size":"xl","w":765.6897224489644,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.3854289378784412,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Transmission modes"}]}]}},"parentId":"page:page","index":"b8SuLvEqV","typeName":"shape"},{"x":-781.9423172646575,"y":29144.04311631222,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:eO9FNQPEcVkaqreCmiofN","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":-960.5474779148597,"y":494.65355382434615},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b8TsjF7xV","typeName":"shape"},{"x":-2044.458433623884,"y":29706.375837954984,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:pROzbn3E98aypX01NSm2N","type":"text","props":{"color":"black","size":"xl","w":437.2103294198,"font":"draw","textAlign":"middle","autoSize":false,"scale":1.4977873252215654,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Simplex mode"}]}]}},"parentId":"page:page","index":"b8UdetxyV","typeName":"shape"},{"x":-2119.2316174391517,"y":29838.667384386605,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:qiss8FGHsBTsfA6eHwPJo","type":"text","props":{"color":"black","size":"xl","w":542.3677976457534,"font":"draw","textAlign":"middle","autoSize":false,"scale":1.4977873252215654,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"communication undirectional in one direction."}]}]}},"parentId":"page:page","index":"b8V4W2dUG","typeName":"shape"},{"x":-140.61829899307213,"y":29167.050042828156,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:FL-7-Kew2GkQ0i-zqFMEw","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":2.8762021337306884,"y":532.0399962567632},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b8WZOU4Bl","typeName":"shape"},{"x":-528.86343