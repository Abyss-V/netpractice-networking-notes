,"font":"draw","scale":1},"parentId":"page:page","index":"b61yVqqwu8","typeName":"shape"},{"x":5880.010100546103,"y":24408.68908186838,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:8SuEgGrLhkyjkvdKCyIyh","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":443.28435727018496,"y":595.6098586658254},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b61yuvdm0d","typeName":"shape"},{"x":5512.032684753223,"y":24418.95834773039,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:lW6dXRZAKY4pwKlmNlzYl","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":-124.94165234633601,"y":605.879124527838},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b61zo9EoeV","typeName":"shape"},{"x":5287.822678150833,"y":24408.68908186838,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:RdNiP0wHWnIaxVxnkUmBN","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":-955.0295380808902,"y":581.91797861959},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b626teFyV","typeName":"shape"},{"x":4118.853022027402,"y":25022.524341626522,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:y2ZBSgRT5GEBNKa4SIu7C","type":"text","props":{"color":"black","size":"xl","w":586.8256458497008,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Packet filtering firewall"}]}]}},"parentId":"page:page","index":"b63fGd7NV","typeName":"shape"},{"x":4007.6043172093086,"y":25101.25487581322,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:29KiAXkUGMcCnrDPNwl6_","type":"text","props":{"color":"black","size":"xl","w":750.2683542560544,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Low cost and low secure because it focus's just on the source ip , destination and port number it does check the payload or the data, this type of firewall used on the routers"}]}]}},"parentId":"page:page","index":"b645FcDZV","typeName":"shape"},{"x":5108.113149792219,"y":25053.331694428387,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:3RxIRT7wOYM9q9RAykkb5","type":"text","props":{"color":"black","size":"xl","w":644.9019976430791,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Stateful inspection firewall"}]}]}},"parentId":"page:page","index":"b65GMU6GG","typeName":"shape"},{"x":5037.940440940168,"y":25126.927462248834,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:omHsvYBUepkgxDFkbhZ_E","type":"text","props":{"color":"black","size":"xl","w":759.5708266604051,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Tracks active connections and makes decisions based on traffic context."}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"More secure than packet filtering"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Remembers past traffic (state table)"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Blocks suspicious or unexpected packets"}]}]}]}]}},"parentId":"page:page","index":"b66HyO97V","typeName":"shape"},{"x":6169.257515893284,"y":25032.793696445366,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:h7olVVofb8wXt9NQ_ZmT3","type":"text","props":{"color":"black","size":"xl","w":545.2860025684322,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Proxy firewall"}]}]}},"parentId":"page:page","index":"b67QpQzMl","typeName":"shape"},{"x":7064.3835220273,"y":25048.197461803135,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:QfW4GW9vtVBhsJWGvgPL6","type":"text","props":{"color":"black","size":"xl","w":502.24988329455397,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Application firewall"}]}]}},"parentId":"page:page","index":"b69sf5eYV","typeName":"shape"},{"x":7023.306814406587,"y":25121.792695882574,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:wpukakF9uUG2Z_a6xiluM","type":"text","props":{"color":"black","size":"xl","w":707.7463592871636,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"A "},{"type":"text","marks":[{"type":"bold"}],"text":"Web Application Firewall (WAF)"},{"type":"text","text":" is "},{"type":"text","marks":[{"type":"bold"}],"text":"a security tool that monitors, filters, and blocks malicious HTTP/HTTPS traffic between a web application and the internet"},{"type":"text","text":". This type of firewall doesn't reside on the transport layer like other firewall, it reside on the application layer"}]}]}},"parentId":"page:page","index":"b6AnjDbeV","typeName":"shape"},{"x":7908.163999462762,"y":25056.755109224116,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:1UYiMza4_Hr5RBm5uLpKN","type":"text","props":{"color":"black","size":"xl","w":677.2068270003465,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Next generation firewall"}]}]}},"parentId":"page:page","index":"b6BBeeC1V","typeName":"shape"},{"x":7933.838009207715,"y":25135.48457592881,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:1xjqtnOX-06d_gKp-pB0J","type":"text","props":{"color":"black","size":"xl","w":639.28446826464,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Advanced firewall combining multiple security features."}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Includes intrusion prevention, malware detection"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Can inspect encrypted traffic"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Provides app-level filtering"}]}]}]}]}},"parentId":"page:page","index":"b6C0Y7NpV","typeName":"shape"},{"x":4003.377899801724,"y":25966.48451442268,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:kcx3I932bUnKX-KkKYhgb","type":"text","props":{"color":"black","size":"xl","w":1145.9517420212314,"font":"draw","textAlign":"middle","autoSize":false,"scale":3.0962495607687344,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"DMZ"}]}]}},"parentId":"page:page","index":"b6DUafHUt","typeName":"shape"},{"x":3910.7937575468377,"y":26241.392667247113,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Xv6T12MKB_eJrUi3J6Wx1","type":"text","props":{"color":"black","size":"xl","w":4592.285241587606,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"A "},{"type":"text","marks":[{"type":"bold"}],"text":"DMZ (Demilitarized Zone)"},{"type":"text","text":" is a "},{"type":"text","marks":[{"type":"bold"}],"text":"buffer network segment"},{"type":"text","text":" that sits between an organization’s internal private network and an untrusted external network, such as the internet. Its primary purpose is to "},{"type":"text","marks":[{"type":"bold"}],"text":"enhance network security"},{"type":"text","text":" by isolating public-facing services—like web servers, email servers, FTP servers, and DNS servers—from the internal network. This prevents direct access to sensitive internal systems even if a DMZ server is compromised."}]}]}},"parentId":"page:page","index":"b6EVNg5UG","typeName":"shape"},{"x":5016.404652224654,"y":26527.75614558734,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:rp17Ec5wMwr-LvhES17jj","type":"text","props":{"color":"black","size":"xl","w":505.2686550120652,"font":"draw","textAlign":"middle","autoSize":false,"scale":3.054324395228344,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Ports"}]}]}},"parentId":"page:page","index":"b6FzFXyU8","typeName":"shape"},{"x":3880.9114935345233,"y":26799.17939789166,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:3lI4Xp6k2zfmzS802ViJi","type":"text","props":{"color":"black","size":"xl","w":3980.3140956464813,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Logical ports"},{"type":"text","text":" are software-defined endpoints used in networking to identify specific services or applications on a device."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"port types:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Well-Known Ports (0–1023)"},{"type":"text","text":": Reserved for standard, widely used services. Examples include "},{"type":"text","marks":[{"type":"bold"}],"text":"port 80 (HTTP), port 443 (HTTPS), port 21 (FTP), and port 22 (SSH)"},{"type":"text","text":". These are managed by the Internet Assigned Numbers Authority (IANA) and are typically used by servers."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Registered Ports (1024–49151)"},{"type":"text","text":": Assigned to specific applications or services by organizations or developers. These are not universally standardized but are registered with IANA for consistency. Examples include "},{"type":"text","marks":[{"type":"bold"}],"text":"port 1433 (Microsoft SQL Server)"},{"type":"text","text":" and "},{"type":"text","marks":[{"type":"bold"}],"text":"port 3306 (MySQL)"},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Dynamic/Private Ports (49152–65535)"},{"type":"text","text":": Used temporarily by client applications for outbound connections. These are often referred to as "},{"type":"text","marks":[{"type":"bold"}],"text":"ephemeral ports"},{"type":"text","text":" because they are dynamically assigned and released after the session ends. They are crucial for enabling multiple simultaneous connections from a single device."}]}]}]}]}},"parentId":"page:page","index":"b6GPcvd3V","typeName":"shape"},{"x":5330.527213297802,"y":27350.363131745024,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:QNhk4LHkNKoET66UwF08Y","type":"text","props":{"color":"black","size":"xl","w":473.02156676718727,"font":"draw","textAlign":"middle","autoSize":false,"scale":1.9779640642560867,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"VLAN"}]}]}},"parentId":"page:page","index":"b6Hi0REGV","typeName":"shape"},{"x":3893.22499182756,"y":27482.112846746753,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:HBbdzyC8cngUWt71JRJws","type":"text","props":{"color":"black","size":"xl","w":4214.981809308337,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"A "},{"type":"text","marks":[{"type":"bold"}],"text":"VLAN (Virtual Local Area Network)"},{"type":"text","text":" is a logical (virtual) way to divide a physical network into multiple separate networks."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Normally, if you connect 20 devices to the same switch, they all belong to the same "},{"type":"text","marks":[{"type":"bold"}],"text":"broadcast domain"},{"type":"text","text":" (they all receive broadcast traffic like ARP requests)."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"With a VLAN, you can split that single physical switch into multiple "},{"type":"text","marks":[{"type":"bold"}],"text":"logical networks"},{"type":"text","text":", even though all devices are connected to the same hardware."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Simple Example:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Imagine a company with:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"IT department"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"HR department"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Finance department"}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"All computers are connected to the same physical switch."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Without VLANs:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Everyone is in the same network."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Broadcast traffic goes to all departments."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Security is weaker."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"With VLANs:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"VLAN 10 → IT"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"VLAN 20 → HR"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"VLAN 30 → Finance"}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Each VLAN acts like a "},{"type":"text","marks":[{"type":"bold"}],"text":"separate network"},{"type":"text","text":", even though they share the same switch."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Devices in VLAN 10 "},{"type":"text","marks":[{"type":"bold"}],"text":"cannot communicate directly"},{"type":"text","text":" with VLAN 20 unless a router (Layer 3 device) allows it."}]}]}},"parentId":"page:page","index":"b6ICQDjQV","typeName":"shape"},{"x":5171.640698206448,"y":28663.236797966485,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:nXXXjDJTgIshOPg2cgT_b","type":"text","props":{"color":"black","size":"xl","w":459.4612668996142,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.2136589770017467,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"VPN"}]}]}},"parentId":"page:page","index":"b6JvXX6jV","typeName":"shape"},{"x":3889.507573003647,"y":28865.280537058963,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:O7dmT5kUvOc1OvYDI93Xh","type":"text","props":{"color":"black","size":"xl","w":4399.644156711377,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"A "},{"type":"text","marks":[{"type":"bold"}],"text":"VPN (Virtual Private Network)"},{"type":"text","text":" is a technology that creates a "},{"type":"text","marks":[{"type":"bold"}],"text":"secure, encrypted tunnel"},{"type":"text","text":" between your device and another network over the internet."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"It allows you to:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Secure your internet connection"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Hide your IP address"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Access remote networks safely"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Protect data from hackers (especially on public Wi-Fi)"}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","text":"Simple Example"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"When you browse normally:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Your PC → ISP → Internet → Website"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"With a VPN:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Your PC → 🔐 Encrypted Tunnel → VPN Server → Internet → Website"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Your ISP cannot see your traffic content."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Websites see the "},{"type":"text","marks":[{"type":"bold"}],"text":"VPN server IP"},{"type":"text","text":", not your real IP."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Main Types of VPN:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"VPNs are generally classified into "},{"type":"text","marks":[{"type":"bold"}],"text":"2 main categories"},{"type":"text","text":":"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Remote Access VPN (Client-to-Site):"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\tUsed when an individual user connects to a private network remotely."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\tExample:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\tYou work from home and connect to your company’s internal network securely."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\tUsed for:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Remote employees"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Secure access to company servers"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Protecting traffic on public Wi-Fi"}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\tReal-world example:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\tCompanies use solutions from providers like Cisco Systems or Fortinet for remote access VPNs."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Site-to-Site VPN:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\tConnects "},{"type":"text","marks":[{"type":"bold"}],"text":"two entire networks"},{"type":"text","text":" together securely over the internet."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\t\tExample:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Company HQ in one city"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Branch office in another city"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Both networks connected via VPN tunnel"}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"\tDevices don’t need VPN software — the routers handle everything."}]}]}},"parentId":"page:page","index":"b6KGolJjV","typeName":"shape"},{"x":5479.461053821974,"y":30875.890677507323,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:RKnSQLEeNVynHT5u4u9In","type":"text","props":{"color":"black","size":"xl","w":269.2084990727526,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.7587863587105566,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"NAT"}]}]}},"parentId":"page:page","index":"b6LHVPxUG","typeName":"shape"},{"x":3884.4699981467274,"y":31124.5137652979,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:ljq9bOKzW2uwB9RmWqeqX","type":"text","props":{"color":"black","size":"xl","w":4146.825587012504,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"NAT"},{"type":"text","text":" stands for "},{"type":"text","marks":[{"type":"bold"}],"text":"Network Address Translation"},{"type":"text","text":", a fundamental networking technology that enables multiple devices on a private network to share a single public IP address when accessing the internet. It works by translating private IP addresses (used internally) into a public IP address (used externally) at the router or firewall level, allowing efficient and secure communication across networks."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Types of NAT:"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Static NAT"},{"type":"text","text":": One-to-one mapping of a private IP to a public IP. Used when a device needs to be accessible from outside (e.g., a web server)."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Dynamic NAT"},{"type":"text","text":": Maps private IPs to a pool of public IPs. Used when multiple devices need temporary access."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Port Address Translation (PAT)"},{"type":"text","text":": The most common form. Allows "},{"type":"text","marks":[{"type":"bold"}],"text":"many devices to share a single public IP"},{"type":"text","text":" by using unique port numbers. This conserves IPv4 addresses and is standard in home routers."}]}]}]}]}},"parentId":"page:page","index":"b6MwzzvHt","typeName":"shape"},{"x":3849.8615800781454,"y":23112.470208963812,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:IU-lMIcBW00d7_SVj4v_n","type":"text","props":{"color":"black","size":"xl","w":4188.458065528514,"font":"draw","textAlign":"start","autoSize":true,"scale":0.9352014315036495,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"heading","attrs":{"dir":"auto","level":5},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"How DHCP Works ?"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Based on the "},{"type":"text","marks":[{"type":"bold"}],"text":"DORA"},{"type":"text","text":" Process, four steps :"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Discover :"},{"type":"text","text":" When a device turns on, it broadcasts a "},{"type":"text","marks":[{"type":"bold"}],"text":"DHCP Discover"},{"type":"text","text":" request :\"Is there a DHCP server? I need an IP address!\";"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Offer :"},{"type":"text","text":" The DHCP server responds with the "},{"type":"text","marks":[{"type":"bold"}],"text":"DHCP Offer"},{"type":"text","text":" suggesting an available IP address;"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Request :"},{"type":"text","text":" The device accept the offer and send a "},{"type":"text","marks":[{"type":"bold"}],"text":"DHCP Request"},{"type":"text","text":";"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Acknowledge :"},{"type":"text","text":" The server sends a final "},{"type":"text","marks":[{"type":"bold"}],"text":"DHCP Acknowledge"},{"type":"text","text":" message, finalizing the lease time and also giving the device other essential details like the "},{"type":"text","marks":[{"type":"bold"}],"text":"Subnet Mask"},{"type":"text","text":" and "},{"type":"text","marks":[{"type":"bold"}],"text":"Default Gateway"},{"type":"text","text":";"}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"heading","attrs":{"dir":"auto","level":5},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Why using DHCP?"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Simplicity :"},{"type":"text","text":" No manual configuration is needed;"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Efficiency :"},{"type":"text","text":" It prevents "},{"type":"text","marks":[{"type":"bold"}],"text":"IP conflicts"},{"type":"text","text":" where two devices accidentally use the same address;"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Scalability :"},{"type":"text","text":" Perfect for networks where devices frequently join and leave (like Coffee Wi-Fi);"}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":4},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Static IP Assignment (Manual)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"IP"},{"type":"text","text":" address being "},{"type":"text","marks":[{"type":"bold"}],"text":"fixed"},{"type":"text","text":" and manually configured by a network administrator or user. It been configured for the devices that has the same location every time, for example :"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Servers :"},{"type":"text","text":" Web Servers, File Servers, Mail servers;"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Network Equipment :"},{"type":"text","text":" Routers, switches and wireless access points;"}]}]}]}]}},"parentId":"page:page","index":"b6begtlAV","typeName":"shape"},{"x":3853.6504639841824,"y":22888.9580833169,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:pbag6vbMsjp_m6EQOb_6l","type":"text","props":{"color":"black","size":"xl","w":1036.03662109375,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The Dynamic IP Assignment "},{"type":"text","marks":[{"type":"bold"}],"text":"DHCP"},{"type":"text","text":" is the most common method. The IP address is assigned "},{"type":"text","marks":[{"type":"bold"}],"text":"automatically"},{"type":"text","text":" and is temporary (it has a lease time)."},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"The server of the DHCP in my home network is the "},{"type":"text","marks":[{"type":"bold"}],"text":"router"},{"type":"text","text":", its manages a pool of available IP addresses given by the ISP."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"hardBreak","attrs":{"dir":"auto"}}]}]}},"parentId":"page:page","index":"b6cFmzf0G","typeName":"shape"},{"x":5458.290555983169,"y":14018.691473813475,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:IDDcfSb44gGKX1--J7aQb","type":"text","props":{"color":"black","size":"xl","w":801.681564345997,"font":"draw","textAlign":"middle","autoSize":true,"scale":2.2537731040140425,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Data link layer:"}]}]}},"parentId":"page:page","index":"b8iaSnV5V","typeName":"shape"},{"x":4016.4076454148026,"y":14247.845254041751,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:A0zfCx1863tVD50cOC6DR","type":"text","props":{"color":"black","size":"xl","w":4041.867342862216,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"Data Link Layer"},{"type":"text","text":" is the "},{"type":"text","marks":[{"type":"bold"}],"text":"second layer of the OSI model"},{"type":"text","text":", standardized by the International Organization for Standardization, and its main role is to "},{"type":"text","marks":[{"type":"bold"}],"text":"ensure reliable transmission of data between two directly connected devices"},{"type":"text","text":" on the same physical network. While the Network Layer handles logical addressing and routing across multiple networks, the Data Link Layer focuses on "},{"type":"text","marks":[{"type":"bold"}],"text":"local delivery"},{"type":"text","text":", meaning it controls how data frames are transmitted over a specific physical link, such as an Ethernet cable or a Wi-Fi connection. This layer is responsible for organizing raw bits from the Physical Layer into structured "},{"type":"text","marks":[{"type":"bold"}],"text":"frames"},{"type":"text","text":", detecting and correcting errors, and controlling access to the shared medium."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"A key function of the Data Link Layer is "},{"type":"text","marks":[{"type":"bold"}],"text":"framing"},{"type":"text","text":", which involves taking a stream of bits from the Physical Layer and packaging them into "},{"type":"text","marks":[{"type":"bold"}],"text":"frames"},{"type":"text","text":" that contain both the data and control information, such as source and destination "},{"type":"text","marks":[{"type":"bold"}],"text":"MAC (Media Access Control) addresses"},{"type":"text","text":". These addresses uniquely identify devices on the same local network, allowing the layer to deliver data to the correct recipient. The Data Link Layer also provides "},{"type":"text","marks":[{"type":"bold"}],"text":"error detection and correction"},{"type":"text","text":", often using techniques such as checksums or cyclic redundancy checks (CRC) to identify corrupted frames and request retransmission if necessary, ensuring reliable communication over a link that may be noisy or unreliable."}]},{"type":"heading","attrs":{"dir":"auto","level":4},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Header (Frame)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Framing which is encapsulates the packet by adding "},{"type":"text","marks":[{"type":"bold"}],"text":"Header"},{"type":"text","text":" and a "},{"type":"text","marks":[{"type":"bold"}],"text":"Trailer (Footer)"},{"type":"text","text":" creating a "},{"type":"text","marks":[{"type":"bold"}],"text":"Frame"}]}]}},"parentId":"page:page","index":"b8jbGwzhG","typeName":"shape"},{"x":3995.125811717541,"y":15248.826410488617,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:5i1WbLyfPyWWKFFa_kOP1","type":"text","props":{"color":"black","size":"xl","w":4078.754447973615,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"Physical Layer"},{"type":"text","text":" is the "},{"type":"text","marks":[{"type":"bold"}],"text":"first and lowest layer of the OSI model"},{"type":"text","text":", standardized by the International Organization for Standardization, and its primary responsibility is to "},{"type":"text","marks":[{"type":"bold"}],"text":"transmit raw data bits over a physical medium"},{"type":"text","text":" between devices. Unlike higher layers that focus on organizing, addressing, or ensuring reliability, the Physical Layer is concerned with the "},{"type":"text","marks":[{"type":"bold"}],"text":"actual electrical, optical, or wireless signals"},{"type":"text","text":" that carry the information. It defines the characteristics of the hardware, cabling, connectors, voltage levels, timing, and data rates needed for devices to physically send and receive binary data."}]}]}},"parentId":"page:page","index":"b8kWOOxCV","typeName":"shape"},{"x":5469.11500446531,"y":15033.975945118418,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:1Abo0WoqVArFJHHLy9L3X","type":"text","props":{"color":"black","size":"xl","w":752.4913569059859,"font":"draw","textAlign":"middle","autoSize":true,"scale":2.2537731040140425,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Physical layer:"}]}]}},"parentId":"page:page","index":"b8lmXIJgV","typeName":"shape"},{"x":5521.514292164048,"y":15614.642207983667,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:zvy6fiKW2w0yhavSpeXdT","type":"text","props":{"color":"black","size":"xl","w":720.2768727667872,"font":"draw","textAlign":"middle","autoSize":true,"scale":2.2537731040140425,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"TCP/IP Model:"}]}]}},"parentId":"page:page","index":"b8mqlDk4V","typeName":"shape"},{"x":4656.361265564443,"y":15806.746255408605,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:o1eE_51Yj8LPWuRplmDkH","type":"image","props":{"w":2254.547680886809,"h":1511.320565496427,"assetId":"asset:-216324696","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"b8nZJ6eqV","typeName":"shape"},{"x":-476.7714557136029,"y":20828.582653083686,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:6T7tl8YPrGepTsVZtM-19","type":"text","props":{"color":"black","size":"xl","w":1208.0802389603423,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Choose mode of transmission (simples, half duplex, full duplex), Authentication, Authorization ,Session management using tokens  and add checkpoints to data so transmition won't start from start if an issue encountered"}]}]}},"parentId":"page:page","index":"b3mdqbVtV","typeName":"shape"},{"x":-600.7339287817427,"y":22222.96026868491,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:6DnhjTGJFPEjKWOJoLRyU","type":"text","props":{"color":"black","size":"xl","w":1627.9854324160815,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"this layer responsible for physical addressing , it takes the packets from network layer and add mac addresses of the source and destination (header) and a trailer, this is called a frame encapsulation,"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"this layer also does error detection and correction using different methods (parity check, check sum, solving an equation and compare the result between the source and destination also uses protocol CSMA for preventing collisions of frames)"}]}]}},"parentId":"page:page","index":"b3vVpgyeV","typeName":"shape"},{"x":3978.0693147760353,"y":18057.163832635644,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:mfp4gXZ9CW4IiXyqresl-","type":"text","props":{"color":"black","size":"xl","w":394.68580625792856,"font":"draw","textAlign":"middle","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Youtube Server"}]}]}},"parentId":"page:page","index":"b5y3mR3eV","typeName":"shape"},{"x":3278.1811193518665,"y":19054.33114989795,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:L_PYL1ljoTTUHA-63_a_j","type":"text","props":{"color":"black","size":"xl","w":889.0024800941856,"font":"draw","textAlign":"middle","autoSize":false,"scale":0.9207225321813504,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Search on the browser: youtube.com"}]}]}},"parentId":"page:page","index":"b5RCtUE2G","typeName":"shape"},{"x":5622.018538435804,"y":7373.255488952561,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:EnGu-O-5Z_XkEn63E5jSW","type":"text","props":{"color":"black","size":"xl","w":548.4940622479346,"font":"draw","textAlign":"middle","autoSize":false,"scale":1.0551006385153021,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"net Mask"}]}]}},"parentId":"page:page","index":"b7Zc3IQJV","typeName":"shape"},{"x":-1778.6935095290205,"y":13177.02251244779,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Wv_3ju7TSKfFR-R1FTrGO","type":"text","props":{"color":"black","size":"xl","w":2809.5414754820404,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"A multi ports RJ45, which connect devices within a single network (LAN). Intelligently forwards data frames based on "},{"type":"text","marks":[{"type":"bold"}],"text":"mac addresses"},{"type":"text","text":", so if a sender want to send a message to RECEIVER-3, even if there is 52 other device plugged in to the switch, only the RECEIVER-3 which gonna get the message."},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"So the Switch is much more secure the HUB!"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"hardBreak","attrs":{"dir":"auto"}}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"What is MAC address ?"},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"Each end-device has it's own "},{"type":"text","marks":[{"type":"bold"}],"text":"mac address"},{"type":"text","text":" which stand for Media Access Control and it is a "},{"type":"text","marks":[{"type":"bold"}],"text":"unique hardware identifier"},{"type":"text","text":" assigned to a network interface controller (NIC) the physical component that allow a device to connect to a network;"}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Unlike the "},{"type":"text","marks":[{"type":"bold"}],"text":"IP"},{"type":"text","text":" address which is used for global routing, the MAC address is only used for "},{"type":"text","marks":[{"type":"bold"}],"text":"local communication"},{"type":"text","text":" within a single LAN segment;"}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"How the Switch Works"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The internal memory of the switch is called "},{"type":"text","marks":[{"type":"bold"}],"text":"MAC Address Table"},{"type":"text","text":" which contain two rows, the port number and the MAC address of the connected device. When the switch powered on the table been empty."}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"When a frame arrives on a switch port, the switch reads the "},{"type":"text","marks":[{"type":"bold"}],"text":"MAC addresses"},{"type":"text","text":" from the frame's header and fill the table with this "},{"type":"text","marks":[{"type":"bold"}],"text":"MAC"},{"type":"text","text":" address and the specific ports the frame was received on, so it knows the port and the MAC address of the source and the destination from the frame."}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Over time, as devices communicate, the switch fills the entire table."}]}]}},"parentId":"page:page","index":"b6QwVlFtV","typeName":"shape"},{"x":-1789.1462393257648,"y":14778.33380134645,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:PulEJUBKqGs5Wcs5gdvfq","type":"text","props":{"color":"black","size":"xl","w":3427.4382239450224,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The router is a networking device that connect "},{"type":"text","marks":[{"type":"bold"}],"text":"different Networks"},{"type":"text","text":" together, it acts as a gateway, connecting "},{"type":"text","marks":[{"type":"bold"}],"text":"LAN"},{"type":"text","text":" to "},{"type":"text","marks":[{"type":"bold"}],"text":"WAN"},{"type":"text","text":" for example connecting the home network with the internet ."},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","marks":[{"type":"bold"}],"text":"Hubs & Switches"},{"type":"text","text":" are used to "},{"type":"text","marks":[{"type":"bold"}],"text":"create"},{"type":"text","text":" networks. while "},{"type":"text","marks":[{"type":"bold"}],"text":"Routers"},{"type":"text","text":" are used to "},{"type":"text","marks":[{"type":"bold"}],"text":"connect"},{"type":"text","text":" networks."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"hardBreak","attrs":{"dir":"auto"}}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Routing Table"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Routers"},{"type":"text","text":" use "},{"type":"text","marks":[{"type":"bold"}],"text":"Internet Protocol (IP)"},{"type":"text","text":" for routing process. Routers route data by using the routing table which is like a road map of a car, so the data can travel across the internet and reach its destination it needs "},{"type":"text","marks":[{"type":"bold"}],"text":"directions"},{"type":"text","text":" to determine how to get there."}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"There are three routing types :"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Directly Connected :"},{"type":"text","text":" Lets say we connect two networks separated by a router, each one with a specific "},{"type":"text","marks":[{"type":"bold"}],"text":"IP"},{"type":"text","text":" address, the router will create automatically the router table with the directly connected routes."},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"When a computer on a "},{"type":"text","marks":[{"type":"code"}],"text":"192"},{"type":"text","text":" network want to connect with a computer on a "},{"type":"text","marks":[{"type":"code"}],"text":"10"},{"type":"text","text":" network, the computer sent a data packet to the router, and the router looks for the destination IP address of the packet, the router looks at the routing table and decide to forward the data out the interface "},{"type":"text","marks":[{"type":"code"}],"text":"Eth1"},{"type":"text","text":" then to the intended computer."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Static route :"},{"type":"text","text":" Static routes are manually configured by a network administrator. Lets say the router is connected to another network with the IP "},{"type":"text","marks":[{"type":"code"}],"text":"174"},{"type":"text","text":", if a computer from the "},{"type":"text","marks":[{"type":"code"}],"text":"192"},{"type":"text","text":" want to connect with a computer from the "},{"type":"text","marks":[{"type":"code"}],"text":"174"},{"type":"text","text":" the router gonna search on the routing table for the interface with this IP address and gonna fail, that when the administrator add the new network "},{"type":"text","marks":[{"type":"code"}],"text":"174"},{"type":"text","text":" to the routing table so the computers of the network "},{"type":"text","marks":[{"type":"code"}],"text":"192"},{"type":"text","text":" could connect with the computers on the network "},{"type":"text","marks":[{"type":"code"}],"text":"174"},{"type":"text","text":". So to connect back an administrator should add the interface at the other router so the computers on the "},{"type":"text","marks":[{"type":"code"}],"text":"174"},{"type":"text","text":" network could connect to the "},{"type":"text","marks":[{"type":"code"}],"text":"192"},{"type":"text","text":" network computers."}]},{"type":"paragraph","attrs":{"dir":"auto"}}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Dynamic routes :"},{"type":"text","text":" Are similar to the static routes the way it works, the difference is how the routing table is filled, on static routes we fill the table manually but on the dynamic routes we use some protocols so the routing table fill itself automatically, some protocols are : "},{"type":"text","marks":[{"type":"code"}],"text":"RIP, OSPF, BGP, IS-IS and EIGPR"},{"type":"text","text":". So what happen is the routers talk with each other and share their routing tables with each other."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"How the Router works"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Determining the best path :"},{"type":"text","text":" When a data packet arrives, the router gets the destination IP address from the header of the packet, then it consult the "},{"type":"text","marks":[{"type":"bold"}],"text":"routing table"},{"type":"text","text":" which is a map of network paths to determine the most efficient route and to forward the packet closer to its final destination."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Forwarding the packet :"},{"type":"text","text":" Once the router knows the best route, the router sends the data packet out through the appropriate network interface"}]}]}]}]}},"parentId":"page:page","index":"b6SCDn1qV","typeName":"shape"},{"x":-1794.5441497554855,"y":18269.02374571242,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:UXTnidff8ofpxBUs9qH-B","type":"text","props":{"color":"black","size":"xl","w":3181.3357780127144,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"ARP (Address Resolution Protocol)"},{"type":"text","text":" is a network protocol that operates at the "},{"type":"text","marks":[{"type":"bold"}],"text":"boundary between the Network Layer and the Data Link Layer"},{"type":"text","text":", and its main purpose is to "},{"type":"text","marks":[{"type":"bold"}],"text":"map logical IP addresses to physical MAC addresses"},{"type":"text","text":" so that devices on a local network can communicate with each other. While the Network Layer uses IP addresses to identify devices across networks, data cannot actually be transmitted over the physical medium without knowing the "},{"type":"text","marks":[{"type":"bold"}],"text":"hardware address"},{"type":"text","text":" of the destination device. ARP solves this problem by providing a method for devices to discover the correct MAC address corresponding to a given IP address on the same local network segment."}]}]}},"parentId":"page:page","index":"b8rzyNqol","typeName":"shape"},{"x":-1805.9639511940195,"y":18876.865104269356,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:zNvG69jSXKHbpr3zwsFK6","type":"text","props":{"color":"black","size":"xl","w":3989.915828260851,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Access Point (AP)"},{"type":"text","text":" is a networking device that allows wireless devices—such as laptops, smartphones, and IoT gadgets—to connect to a wired network using Wi-Fi or other wireless standards. It acts as a bridge between wireless clients and the wired network, enabling seamless internet access and communication"}]}]}},"parentId":"page:page","index":"b6OaPNPMV","typeName":"shape"},{"x":-1814.6360260017616,"y":19233.342630552226,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:V7TuJpAsgDV40ZxkSW-0D","type":"text","props":{"color":"black","size":"xl","w":2871.623779296875,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"is a device or software that connects two or more network segments, allowing them to function as a single, unified network"}]}]}},"parentId":"page:page","index":"b6e5f5AWV","typeName":"shape"},{"x":4327.808468949623,"y":17559.107144835616,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:-OemGj7QKFsQaaEOe8uf9","type":"text","props":{"color":"black","size":"xl","w":945.5540388116095,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.9261144438091184,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"DNS"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Domain Name System"}]}]}},"parentId":"page:page","index":"b5KQZnKxV","typeName":"shape"},{"x":5566.306940841194,"y":8124.306207293187,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:YED5JhY0UpO5q_FzcUqRp","type":"text","props":{"color":"black","size":"xl","w":1091.0985758154657,"font":"draw","textAlign":"start","autoSize":false,"scale":1.4246111012916727,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"net Mask: 255.255.255.0"}]}]}},"parentId":"page:page","index":"b7dkYkQ0V","typeName":"shape"},{"x":6188.083628564773,"y":25099.542812588024,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:LfLM3mvRLufBfKgXLeA_n","type":"text","props":{"color":"black","size":"xl","w":605.0375360072612,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Acts as a middleman between user and destination server."}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Filters data at the application layer"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Hides internal network details"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Can block malicious content before it reaches the user"}]}]}]}]}},"parentId":"page:page","index":"b68iXP6rV","typeName":"shape"},{"x":3892.050645334736,"y":32165.320877346436,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:eklzoRaRmIt5bATChV1sK","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":126.8096762927571,"y":-518.0307853192753},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b8trNRJeV","typeName":"shape"},{"x":3549.3937567419607,"y":32216.56605494068,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:ruesGnIb2m-IWiyaLSOuT","type":"text","props":{"color":"red","size":"xl","w":495.753883223254,"font":"draw","textAlign":"start","autoSize":false,"scale":3.3607830251237973,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"IMPORTANT!!!!"}]}]}},"parentId":"page:page","index":"b8uIhX8oV","typeName":"shape"},{"x":-851.1658224137714,"y":12972.868516123535,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:8PcHYQJzybU8DVF9aq_ML","type":"text","props":{"color":"black","size":"xl","w":550.606453673413,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.328671467202031,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Switch"}]}]}},"parentId":"page:page","index":"b6RfPCi1V","typeName":"shape"},{"x":-1822.3612210346196,"y":16654.200337102255,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:XF5FRz9sRUFg2HrpVDgFg","type":"text","props":{"color":"black","size":"xl","w":3308.80712890625,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":" Router has "},{"type":"text","marks":[{"type":"bold"}],"text":"interface IPs"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Every router interface connected to a network has a "},{"type":"text","marks":[{"type":"bold"}],"text":"device IP"},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"These are manually configured or assigned via DHCP if supported."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Example:"}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"eth0 → 192.168.1.1/24"},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"eth1 → 10.0.0.1/24"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"These IPs allow the router to "},{"type":"text","marks":[{"type":"bold"}],"text":"talk on that network"},{"type":"text","text":", and they are the "},{"type":"text","marks":[{"type":"bold"}],"text":"source IPs"},{"type":"text","text":" when the router itself sends traffic."}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":"Routing Table stores "},{"type":"text","marks":[{"type":"bold"}],"text":"network IPs (prefixes)"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Routing protocols like "},{"type":"text","marks":[{"type":"bold"}],"text":"RIP, OSPF, BGP"},{"type":"text","text":" "},{"type":"text","marks":[{"type":"bold"}],"text":"do not tell the router about individual device IPs"},{"type":"text","text":", they tell it about "},{"type":"text","marks":[{"type":"bold"}],"text":"networks/subnets"},{"type":"text","text":" it can reach."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Example:"}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"192.168.1.0/24 → directly connected via eth0"},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"10.0.0.0/24 → directly connected via eth1"},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"172.16.0.0/16 → via next-hop 10.0.0.254"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"These entries tell the router: “If a packet’s destination IP matches this network, send it via this interface or next-hop IP.”"}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":"How actual device IPs are “known”"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Routers don’t store every device’s IP in the routing table."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Devices’ IPs are only needed "},{"type":"text","marks":[{"type":"bold"}],"text":"on the local network"},{"type":"text","text":", for delivery within the LAN:"}]}]}]},{"type":"orderedList","attrs":{"dir":"auto","start":1,"type":null},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Router checks routing table → decides the "},{"type":"text","marks":[{"type":"bold"}],"text":"next hop"},{"type":"text","text":"."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"If the next hop is on the "},{"type":"text","marks":[{"type":"bold"}],"text":"same LAN"},{"type":"text","text":", router uses "},{"type":"text","marks":[{"type":"bold"}],"text":"ARP"},{"type":"text","text":" to resolve the device IP → MAC."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The resolved MAC is stored in the "},{"type":"text","marks":[{"type":"bold"}],"text":"ARP cache"},{"type":"text","text":", not the routing table."}]}]}]}]}},"parentId":"page:page","index":"b8qnmWzOl","typeName":"shape"},{"x":-871.2834613046284,"y":21630.20691818895,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:0eLe9FTK0BnDoxS0mgBF1","type":"draw","props":{"segments":[{"type":"free","path":""}],"color":"black","fill":"none","dash":"draw","size":"m","isComplete":true,"isClosed":false,"isPen":false,"scale":1,"scaleX":1,"scaleY":1},"parentId":"page:page","index":"b9duuCRaV","typeName":"shape"},{"x":-799.4591329824457,"y":21667.1450436182,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:m16g0LkmMCRN6Hw_EBkBG","type":"draw","props":{"segments":[{"type":"free","path":"AAAAAAAAAAAAAAA/"}],"color":"black","fill":"none","dash":"draw","size":"m","isComplete":true,"is