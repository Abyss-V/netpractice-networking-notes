":"1 - limited broadcast:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"broadcast data on all devices that exist in the current network"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"2 - direct broadcast:"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"send data to all devices that exist on another network"}]}]}},"parentId":"page:page","index":"b3Kl5zW1G","typeName":"shape"},{"x":-1366.2889561383786,"y":10826.587967703614,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:H6FB1kiR7Jm2gM3SrWTph","type":"text","props":{"color":"black","size":"xl","w":811.9118987156546,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.222003952577659,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Type of networks"}]}]}},"parentId":"page:page","index":"b3VwpQ6Ul","typeName":"shape"},{"x":-1738.7865855815917,"y":11007.076678534522,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Uyvy8AOwXKj9SymdUR9Lh","type":"text","props":{"color":"black","size":"xl","w":1948.8003033322436,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"PAN: (Personal network area) is a network used at homes connecting devices between each other using bluetooth or cables,...."}]}]}},"parentId":"page:page","index":"b3WyjM6IV","typeName":"shape"},{"x":-1741.43734546022,"y":11176.773381438848,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:-ilZPyLgAQ3g_MDtiiUNc","type":"text","props":{"color":"black","size":"xl","w":1469.1375732421875,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"LAN: (Local Area Network) is a network of devices connected to each other localy using a switch and ethernet cables. "}]}]}},"parentId":"page:page","index":"b3XeMYyaV","typeName":"shape"},{"x":-1740.26302905397,"y":11348.222722259161,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:VDqnsoyN4R467Vq1T4Ucs","type":"text","props":{"color":"black","size":"xl","w":1470.8713684082031,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"WLAN: (Wireless local area network) the same as LAN but using a wireless connection between devices and router"}]}]}},"parentId":"page:page","index":"b3YO2UUjO","typeName":"shape"},{"x":-1750.831861451431,"y":11560.773381438848,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:u3Aqkyw2iN0x2fGeo_cAQ","type":"text","props":{"color":"black","size":"xl","w":1531.26611328125,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"CAN: (Campus area network) is multiple LAN networks connected to each other Ex: inside a campus"}]}]}},"parentId":"page:page","index":"b3Z2pJMHV","typeName":"shape"},{"x":-1752.0061473401029,"y":11736.919987884161,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Yg3oa-SODfDypJJ-8W3r_","type":"text","props":{"color":"black","size":"xl","w":1572.7523193359375,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"MAN: (Metropolitan Area Network) Same as can but in bigger scale and using high speed connections like fiber"}]}]}},"parentId":"page:page","index":"b3aiUC1rG","typeName":"shape"},{"x":-1754.354795411392,"y":11917.470402923223,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:HkiRcLTU4TnOuMxbAhxVk","type":"text","props":{"color":"black","size":"xl","w":1566.5320739746094,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"SAN: (Storage area network) High speed network , its job to store data using disk arrays , servers and switches that make the connections between server and the storage"}]}]}},"parentId":"page:page","index":"b3bb2OHuV","typeName":"shape"},{"x":-1757.8777141125638,"y":12154.681462493536,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:S6r3bm1wEGx0ujxx9SwTF","type":"text","props":{"color":"black","size":"xl","w":1618.8438720703125,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"WAN: (Wide area network) is a network that cover large scale and connect networks between each other on larger scale and distances"}]}]}},"parentId":"page:page","index":"b3cyDxr5V","typeName":"shape"},{"x":-1047.5357642701474,"y":14555.74902134042,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:QzNg4nWPAEBILA7nZMepA","type":"text","props":{"color":"black","size":"xl","w":872.2117598311356,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.1260655014979104,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Router"}]}]}},"parentId":"page:page","index":"b6THnmjUl","typeName":"shape"},{"x":-1765.0174657570888,"y":12482.25798478024,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:9_PvBY6l_77iEwyhqTtKs","type":"text","props":{"color":"black","size":"xl","w":3993.9936526196457,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Its role is to regenerates the weakened network signals to extend the signal's reach over longer distances, the repeater contain only two ports."}]}]}},"parentId":"page:page","index":"b6gcnvS9V","typeName":"shape"},{"x":-695.5218429998035,"y":12334.584913871171,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:bscX2gCm7fNSq9wE3CqZx","type":"text","props":{"color":"black","size":"xl","w":377.4320276545641,"font":"draw","textAlign":"middle","autoSize":false,"scale":2.1069120694472034,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Repeater"}]}]}},"parentId":"page:page","index":"b6hKuE6mV","typeName":"shape"},{"x":-420.72715661431107,"y":12589.190318185247,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:O2hh5lS2WwQyC_pEA7h1G","type":"text","props":{"color":"black","size":"xl","w":69.96330261230469,"font":"draw","textAlign":"middle","autoSize":true,"scale":1.5086121110922823,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Hub"}]}]}},"parentId":"page:page","index":"b6ivunLUl","typeName":"shape"},{"x":-1769.8303013771147,"y":12739.750881760257,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Pb6C2jvqW_6mCD7gu_W5f","type":"text","props":{"color":"black","size":"xl","w":3481.891189749266,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Is a multi ports repeater, that broadcasts "},{"type":"text","marks":[{"type":"bold"}],"text":"any"},{"type":"text","text":" incoming signal to "},{"type":"text","marks":[{"type":"bold"}],"text":"all"},{"type":"text","text":" other ports, without exceptions, so if the sender want to send a message to RECEIVER-3, the Hub send this message to all the RECEIVERS connected to the HUB."}]}]}},"parentId":"page:page","index":"b6jdKuYHV","typeName":"shape"},{"id":"asset:-388967680","type":"image","typeName":"asset","props":{"name":"tldrawFile","src":"data:image/png;base64,","w":958,"h":508,"fileSize":170330,"mimeType":"image/png","isAnimated":false},"meta":{"fileId":"vqNuFD_oI1j_Efbg0Hhi9"}},{"x":3950.4108943677984,"y":8822.476091801156,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:-Jo9CJrpB2oxa9pdZTZYR","type":"text","props":{"color":"black","size":"xl","w":911.1811619197338,"font":"draw","textAlign":"start","autoSize":false,"scale":1.9051753880259399,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"IP address classes:"}]}]}},"parentId":"page:page","index":"b7j75usDV","typeName":"shape"},{"x":3950.7038605870357,"y":8992.229517143478,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:FhoEKP85VQaqREcuy4cnZ","type":"image","props":{"w":2989,"h":1587,"assetId":"asset:-796411444","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"b7kODipzl","typeName":"shape"},{"x":3965.772102851677,"y":10602.403681359148,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:kwbQPEJpcw4jbcRpVE9qK","type":"text","props":{"color":"black","size":"xl","w":1659.9338782697005,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"-> note that 127 does not exist in the ranges of classes because its loopback address and it uses to check and troubleshoot the device itself"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"-> in the example class C  the host ranges between 1-254 because 0 represent the network its self and 255 its for broadcasting"}]}]}},"parentId":"page:page","index":"b7lsRzgaG","typeName":"shape"},{"x":6949.5975322100185,"y":9799.260342290112,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:nZJls9y8x6ix02k3TM14Z","type":"arrow","props":{"kind":"arc","elbowMidPoint":0.5,"dash":"draw","size":"xl","fill":"none","color":"black","labelColor":"black","bend":0,"start":{"x":0,"y":0},"end":{"x":516.5052165786647,"y":3.840202323612175},"arrowheadStart":"none","arrowheadEnd":"arrow","richText":{"type":"doc","content":[{"type":"paragraph"}]},"labelPosition":0.5,"font":"draw","scale":1},"parentId":"page:page","index":"b7mhLpjRV","typeName":"shape"},{"x":3948.4907932059928,"y":11010.801175457145,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:lEdIybwr8DIp2PNphgWGw","type":"text","props":{"color":"black","size":"xl","w":1168.4828378351876,"font":"draw","textAlign":"start","autoSize":false,"scale":1.9292758858142633,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Type of Ip addresses:"}]}]}},"parentId":"page:page","index":"b7opzTxQG","typeName":"shape"},{"x":3952.3309955296045,"y":11163.791162797668,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:dc7_9jnukXUYbYIy2tmjy","type":"text","props":{"color":"black","size":"xl","w":726.7766096384632,"font":"draw","textAlign":"start","autoSize":false,"scale":1.0646558649292763,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Public Ip addresses:"}]}]}]}]}},"parentId":"page:page","index":"b7pGzlKfG","typeName":"shape"},{"x":4059.856261401311,"y":11246.355313160613,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:K6mauGOxlY7VSDwhwshX-","type":"text","props":{"color":"black","size":"xl","w":1559.7633491020108,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Given to you by you're internet provider Most of public addresses uses IPV4 now but we're starting to translate to IPV4 because it has more ip addresses than IPV6"}]}]}},"parentId":"page:page","index":"b7qszwqZG","typeName":"shape"},{"x":4060.9165770901773,"y":11446.240416656536,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:L1K6uITZDnQBM0S8XMcXu","type":"image","props":{"w":1278.0986052656979,"h":581.0890170452185,"assetId":"asset:1975849412","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"b7rpPobMV","typeName":"shape"},{"x":3942.730789112648,"y":12089.276330083285,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:gn5ZweFHGkwYrj9FkPvF5","type":"text","props":{"color":"black","size":"xl","w":747.0919452797998,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Private Ip addresses:"}]}]}]}]}},"parentId":"page:page","index":"b7sZrZ9AV","typeName":"shape"},{"x":4044.495851296293,"y":12177.601183121089,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:xox64up-cPY7OhBP0KCwt","type":"text","props":{"color":"black","size":"xl","w":1651.2367320461337,"font":"draw","textAlign":"start","autoSize":false,"scale":0.9632160704736102,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Created to solve run out of ipv4 problem assigning private addresses with subnet 255.255.255.0 to devices using DHCP Protocol and translate them to public address using NAT protocol this public address provided by you're Internet provider but this didn't fix run out problem that why we introduced IPV6."}]}]}},"parentId":"page:page","index":"b7t2iVyYV","typeName":"shape"},{"x":4791.938000428732,"y":1341.368480805926,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Z6EcOgXBNbkbvhuGalP2k","type":"text","props":{"color":"black","size":"xl","w":574.6837180436387,"font":"draw","textAlign":"middle","autoSize":false,"scale":3.670245745965145,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"TCP"}]}]}},"parentId":"page:page","index":"b7xfzlTjl","typeName":"shape"},{"x":5238.879095140508,"y":3174.916946215195,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:zONeOai6NlJQKwTVi1dcC","type":"image","props":{"w":1741.2764079522829,"h":1424.6806974155043,"assetId":"asset:-1692738616","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"b7zE2wYZV","typeName":"shape"},{"x":7309.085099416909,"y":3092.7349598227192,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:rSLoLg3kY7ywnUlRS_1ml","type":"image","props":{"w":1522.1203280045154,"h":1449.6384076233483,"assetId":"asset:-1408546517","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"b80FTUXwG","typeName":"shape"},{"x":3400.915438858484,"y":3268.6280709005914,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:zwOPfdpTnyk2eNF5fCpOX","type":"image","props":{"w":1649.085247141386,"h":1374.2377059511548,"assetId":"asset:2146645381","playing":true,"url":"","crop":null,"flipX":false,"flipY":false,"altText":""},"parentId":"page:page","index":"b81EHfj7V","typeName":"shape"},{"x":3922.691674770247,"y":571.8721871654861,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:zUIGMj2iFqbColeWV6EJ0","type":"text","props":{"color":"black","size":"xl","w":4094.8882645649815,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"UDP"},{"type":"text","text":" stands for User Datagram Protocol, described as \"fire-and-forget\", provides a connectionless transport service, it doesn't care about the connection with the server, it just send the data even is some is lost it continue sending the rest."},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"We use UDP when speed is important than absolute accuracy, UDP is much faster than TCP because it avoid the handshakes, sequence numbering and making sure that the data is received well or not."}]},{"type":"heading","attrs":{"dir":"auto","level":4},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Header (Datagram)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The UDP header is extremely simple, it contain only four fields :"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Source Port Number;"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Destination Port Number;"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Length"},{"type":"text","text":" (of the entire datagram) "},{"type":"text","marks":[{"type":"bold"}],"text":";"}]}]}]}]}},"parentId":"page:page","index":"b8erU0EvG","typeName":"shape"},{"x":3923.2938523387334,"y":-714.457891482215,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:2x72plGEuE31rXITC1i7T","type":"text","props":{"color":"black","size":"xl","w":4678.895566061359,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The "},{"type":"text","marks":[{"type":"bold"}],"text":"Transport Layer"},{"type":"text","text":" is the "},{"type":"text","marks":[{"type":"bold"}],"text":"fourth layer of the OSI model"},{"type":"text","text":", defined by the International Organization for Standardization, and its primary role is to provide "},{"type":"text","marks":[{"type":"bold"}],"text":"reliable and efficient delivery of data between two devices on a network"},{"type":"text","text":". Unlike the lower layers, which focus on moving raw data from one device to another, the Transport Layer ensures that the "},{"type":"text","marks":[{"type":"bold"}],"text":"entire message is delivered correctly, in order, and without errors"},{"type":"text","text":", even if the network itself is unreliable. It acts as a bridge between the "},{"type":"text","marks":[{"type":"bold"}],"text":"networking functions of the lower layers"},{"type":"text","text":" and the "},{"type":"text","marks":[{"type":"bold"}],"text":"application-level services"},{"type":"text","text":" used by software, giving applications confidence that their data will arrive safely and completely."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"One of the most important functions of the Transport Layer is "},{"type":"text","marks":[{"type":"bold"}],"text":"segmentation and reassembly"},{"type":"text","text":". Large messages generated by applications are broken into smaller units called segments before transmission. These segments are labeled with sequence numbers, sent across the network, and then "},{"type":"text","marks":[{"type":"bold"}],"text":"reassembled in the correct order"},{"type":"text","text":" at the receiving side. This ensures that even if segments arrive out of order, the original message is reconstructed accurately. Another critical function is "},{"type":"text","marks":[{"type":"bold"}],"text":"error detection and correction"},{"type":"text","text":", which allows the layer to detect missing or corrupted segments and request retransmission, providing reliability over networks that may lose or alter data during transit."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The Transport Layer also manages "},{"type":"text","marks":[{"type":"bold"}],"text":"flow control"},{"type":"text","text":" and "},{"type":"text","marks":[{"type":"bold"}],"text":"congestion control"},{"type":"text","text":", which prevent network overload and ensure that the sender does not overwhelm the receiver with too much data at once. It also supports "},{"type":"text","marks":[{"type":"bold"}],"text":"multiplexing"},{"type":"text","text":", allowing multiple applications to communicate simultaneously over the same network connection by using unique identifiers called port numbers. Common protocols operating at this layer include "},{"type":"text","marks":[{"type":"bold"}],"text":"TCP (Transmission Control Protocol)"},{"type":"text","text":", which provides reliable, connection-oriented communication, and "},{"type":"text","marks":[{"type":"bold"}],"text":"UDP (User Datagram Protocol)"},{"type":"text","text":", which provides faster, connectionless communication for applications that can tolerate some data loss, such as video streaming or online gaming."}]}]}},"parentId":"page:page","index":"b8KRlDFRV","typeName":"shape"},{"x":5298.9898917251685,"y":-971.0880885842007,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Am9mZHmhx96-w_bWq7fiC","type":"text","props":{"color":"black","size":"xl","w":272.4953918457031,"font":"draw","textAlign":"middle","autoSize":true,"scale":2.2537731040140425,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Transportation layer:"}]}]}},"parentId":"page:page","index":"b8LdKUUpd","typeName":"shape"},{"x":4781.140058737135,"y":185.99320959384204,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:Nrf1z5QJ0VLRgNdQuPNZ5","type":"text","props":{"color":"black","size":"xl","w":574.6837180436387,"font":"draw","textAlign":"middle","autoSize":false,"scale":3.670245745965145,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"UDP"}]}]}},"parentId":"page:page","index":"b8frynEvV","typeName":"shape"},{"x":3930.923453847736,"y":1587.1978297877613,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:oNLzkwJIaEB3Iv9eLIBMV","type":"text","props":{"color":"black","size":"xl","w":3984.22292010001,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"TCP (Transmission Control Protocol)"},{"type":"text","text":" is a "},{"type":"text","marks":[{"type":"bold"}],"text":"core protocol of the Transport Layer"},{"type":"text","text":" in the OSI model, designed to provide "},{"type":"text","marks":[{"type":"bold"}],"text":"reliable, connection-oriented communication between devices on a network"},{"type":"text","text":"."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Happens only on the TCP! Since the physical networks have a limit on the maximum size of data unit, and we don't want any "},{"type":"text","marks":[{"type":"bold"}],"text":"data lost"},{"type":"text","text":", this layer break the data into smaller chunks suitable for transmission as "},{"type":"text","marks":[{"type":"bold"}],"text":"segments"},{"type":"text","text":"."}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"heading","attrs":{"dir":"auto","level":4},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Header (Segment)"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Each segment is tagged with :"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Source and Destination Ports, data offset, header length ..."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Sequence Number"},{"type":"text","text":" Indicate the position of the first byte of data carried by the current segment; Helps also to put the segments back together to build the original data before sending it to the Session Layer."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Acknowledgment Number"},{"type":"text","text":" Indicate the next expected byte the receiver wait from the sender;"}]}]}]},{"type":"heading","attrs":{"dir":"auto","level":4},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Handshake"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Before any data is transferred, TCP make sure both hosts are ready for connection :"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Synchronize :"},{"type":"text","text":" The client sent the segment proposing the initial sequence number "},{"type":"text","marks":[{"type":"bold"}],"text":"X"},{"type":"text","text":" to start communication;"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"SYN Acknowledge :"},{"type":"text","text":" The server reply with a segment includes its own sequence number "},{"type":"text","marks":[{"type":"bold"}],"text":"Y"},{"type":"text","text":" and the acknowledge number that equal "},{"type":"text","marks":[{"type":"bold"}],"text":"X + 1"},{"type":"text","text":", so it means am waiting for the next segment."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Acknowledge :"},{"type":"text","text":" The client sends a final segment acknowledging the server's sequence number "},{"type":"text","marks":[{"type":"bold"}],"text":"Y + 1"},{"type":"text","text":" At this point the connection is established and data transfer can begin!"}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"TCP"},{"type":"text","text":" guarantees that all data arrives in order and without errors using the system of sequence numbers and acknowledgments."},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"The client send a segment and wait the confirmation of the server then continue."},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"If the sender does not receive an "},{"type":"text","marks":[{"type":"bold"}],"text":"ACK"},{"type":"text","text":" for a segment within a calculated time period, it assumes the segment was "},{"type":"text","marks":[{"type":"bold"}],"text":"lost"},{"type":"text","text":" and "},{"type":"text","marks":[{"type":"bold"}],"text":"retransmits"},{"type":"text","text":" it again."},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"After finishing the data transfer the "},{"type":"text","marks":[{"type":"bold"}],"text":"TCP"},{"type":"text","text":" gracefully closes the connection using "},{"type":"text","marks":[{"type":"bold"}],"text":"FIN (Finish)"},{"type":"text","text":" and "},{"type":"text","marks":[{"type":"bold"}],"text":"ACK"},{"type":"text","text":" segments, ensuring both sides agree to stop sending data."}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"hardBreak","attrs":{"dir":"auto"}}]}]}},"parentId":"page:page","index":"b7yBWyb2V","typeName":"shape"},{"x":7574.912228444195,"y":8904.720352462591,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:fY60uuc_ZdOxfYM5K_ePE","type":"text","props":{"color":"black","size":"xl","w":970.8990478515625,"font":"draw","textAlign":"start","autoSize":true,"scale":0.7479166361880001,"richText":{"type":"doc","attrs":{"dir":"auto"},"content":[{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","text":"🔹 "},{"type":"text","marks":[{"type":"bold"}],"text":"Class A"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Range:"},{"type":"text","text":" "},{"type":"text","marks":[{"type":"code"}],"text":"1.0.0.0 – 126.255.255.255"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Default mask:"},{"type":"text","text":" "},{"type":"text","marks":[{"type":"code"}],"text":"255.0.0.0"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Size:"},{"type":"text","text":" Few networks, "},{"type":"text","marks":[{"type":"bold"}],"text":"very many hosts"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Purpose:"},{"type":"text","text":" Huge organizations with millions of devices."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Example networks used historically by companies like"},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"IBM and"},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","text":"AT&T"}]},{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","text":"🔹 "},{"type":"text","marks":[{"type":"bold"}],"text":"Class B"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Range:"},{"type":"text","text":" "},{"type":"text","marks":[{"type":"code"}],"text":"128.0.0.0 – 191.255.255.255"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Default mask:"},{"type":"text","text":" "},{"type":"text","marks":[{"type":"code"}],"text":"255.255.0.0"}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Size:"},{"type":"text","text":" Medium networks, many hosts."}]}]},{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Purpose:"},{"type":"text","text":" Universities, big companies."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Example:"},{"type":"hardBreak","attrs":{"dir":"auto"}},{"type":"text","marks":[{"type":"code"}],"text":"172.16.0.0"},{"type":"text","text":" (also private range)"}]},{"type":"heading","attrs":{"dir":"auto","level":2},"content":[{"type":"text","text":"🔹 "},{"type":"text","marks":[{"type":"bold"}],"text":"Class C"}]},{"type":"bulletList","attrs":{"dir":"auto"},"content":[{"type":"listItem","attrs":{"dir":"auto"},"content":[{"type":